# Set these environment variables before starting the backend. No dotenv auto-loading.
STUDIO_DATA_DIR=C:\电商\data
# Required only when a provider reads input files via URLs instead of inline Base64.
STUDIO_PUBLIC_BASE_URL=
# Enable behind HTTPS in production.
STUDIO_SECURE_COOKIE=false
# Comma-separated trusted browser origins for deployed frontends.
STUDIO_ALLOWED_ORIGINS=
